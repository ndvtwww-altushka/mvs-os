#!/bin/sh
# MVS OS — идентичность и инструменты обслуживания внутри образа.
#
# Репозиторий может лежать на FAT/exFAT, где права не хранятся, поэтому
# исполняемые биты выставляются здесь. Здесь же создаётся маркер Live:
# по нему mvs-identity понимает, что образ загрузочный, а не установленный.
set -e

echo "▸ MVS OS: идентичность и снимки"

chmod 755 /usr/local/sbin/mvs-identity
chmod 755 /usr/local/sbin/mvs-snapshot
chmod 755 /usr/local/sbin/mvs-live-user
chmod 755 /usr/local/sbin/mvs-boot-check
chmod 755 /usr/local/bin/mvs-session-mode
chmod 755 /usr/local/bin/mvs-app
chmod 755 /usr/local/sbin/mvs-live-tuning
chmod 644 /etc/systemd/system/mvs-live-tuning.service
chmod 644 /etc/xdg/autostart/mvs-session-mode.desktop
# Ярлыки на рабочем столе должны запускаться без вопроса «недоверенный».
chmod 755 /etc/skel/Desktop/*.desktop
chmod 755 /etc/grub.d/40_mvs_snapshots
chmod 644 /etc/apt/apt.conf.d/99-mvs-identity
chmod 644 /etc/systemd/system/mvs-identity.service
chmod 644 /etc/systemd/system/mvs-live-user.service
chmod 644 /etc/systemd/system/mvs-boot-check.service

install -d -m 755 /etc/systemd/system/multi-user.target.wants
ln -sf /etc/systemd/system/mvs-identity.service \
    /etc/systemd/system/multi-user.target.wants/mvs-identity.service

# Пользователь Live: создаётся до LightDM, не полагаясь на компонент
# live-config/0030-user-setup, который может молча выйти.
ln -sf /etc/systemd/system/mvs-live-user.service \
    /etc/systemd/system/multi-user.target.wants/mvs-live-user.service

# Подтверждение входа: служба запускается после LightDM и сообщает
# QEMU-тесту, что сеанс mvs действительно поднялся. Без неё тест
# принимал меню GRUB за рабочий стол.
install -d -m 755 /etc/systemd/system/graphical.target.wants
ln -sf /etc/systemd/system/mvs-boot-check.service \
    /etc/systemd/system/graphical.target.wants/mvs-boot-check.service

# Тюнинг Live: zram, swappiness и watchdog. Без него swap в сжатой
# памяти почти не используется, а vm.swappiness=10 из hardening-файла
# заставляет систему ждать до последнего.
ln -sf /etc/systemd/system/mvs-live-tuning.service \
    /etc/systemd/system/multi-user.target.wants/mvs-live-tuning.service

# Явно включаем графику: в chroot debconf не всегда выбирает LightDM.
systemctl enable lightdm.service >/dev/null 2>&1 || true
systemctl set-default graphical.target >/dev/null 2>&1 || true

# Каталог снимков существует в образе, чтобы установщик мог смонтировать
# в него субтом @snapshots (и на ext4 он просто останется пустым).
install -d -m 755 /mvs-snapshots

# Маркер загрузочного образа. Установщик удаляет его, после чего
# mvs-identity пишет имя системы без пометки «Live».
: > /etc/mvs-live
chmod 644 /etc/mvs-live

/usr/local/sbin/mvs-identity

# Проверка результата: если идентичность не записалась, сборка должна
# упасть здесь, а не после публикации релиза.
if ! grep -q '^ID=mvs$' /etc/os-release; then
    echo "ОШИБКА: /etc/os-release не содержит ID=mvs" >&2
    exit 1
fi

echo "▸ MVS OS: идентичность и снимки готовы"
