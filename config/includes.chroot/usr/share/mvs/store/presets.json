{
  "version": 1,
  "sets": [
    {
      "id": "office",
      "name": "Офис и документы",
      "description": "Тексты, таблицы, презентации, PDF",
      "packages": [
        "libreoffice-writer",
        "libreoffice-calc",
        "libreoffice-impress",
        "libreoffice-gtk3",
        "atril",
        "hunspell-ru"
      ]
    },
    {
      "id": "media",
      "name": "Мультимедиа",
      "description": "Видео, музыка, запись звука",
      "packages": ["vlc", "mpv", "rhythmbox", "audacity", "handbrake"]
    },
    {
      "id": "dev",
      "name": "Разработка",
      "description": "Git, Python, компиляторы, SSH",
      "packages": [
        "git",
        "python3",
        "python3-pip",
        "python3-venv",
        "build-essential",
        "openssh-client",
        "vim",
        "tmux",
        "gdb",
        "strace"
      ]
    },
    {
      "id": "code",
      "name": "Редактор кода",
      "description": "VS Code из репозитория Microsoft (дополнительный источник)",
      "packages": ["code"],
      "repository": "vscode"
    },
    {
      "id": "games",
      "name": "Игры и платформы",
      "description": "Steam, Lutris, Wine",
      "packages": ["steam-installer", "lutris", "wine", "winetricks"]
    },
    {
      "id": "graphics",
      "name": "Графика и дизайн",
      "description": "GIMP, Inkscape, чертежи",
      "packages": ["gimp", "inkscape", "krita", "blender"]
    },
    {
      "id": "network",
      "name": "Сеть и удалённый доступ",
      "description": "Диагностика, SSH-сервер, торренты",
      "packages": ["nmap", "traceroute", "openssh-server", "transmission-gtk", "filezilla"]
    },
    {
      "id": "print",
      "name": "Печать и сканирование",
      "description": "Драйверы и утилиты принтеров",
      "packages": ["cups", "system-config-printer", "simple-scan", "sane-utils"]
    },
    {
      "id": "nvidia",
      "name": "Драйвер NVIDIA",
      "description": "Проприетарный драйвер и панель настроек (non-free)",
      "packages": ["nvidia-detect", "nvidia-driver", "nvidia-settings"]
    },
    {
      "id": "codecs",
      "name": "Мультимедиа-кодеки",
      "description": "Дополнительные кодеки для видео и аудио",
      "packages": ["libavcodec-extra", "gstreamer1.0-libav", "gstreamer1.0-plugins-bad"]
    },
    {
      "id": "browsers",
      "name": "Браузеры",
      "description": "Chromium, Epiphany, Falkon — на выбор",
      "packages": ["chromium", "epiphany-browser", "falkon"]
    },
    {
      "id": "photo",
      "name": "Фотография",
      "description": "Обработка RAW, каталог снимков, публикация",
      "packages": ["darktable", "digikam", "rawtherapee", "scribus"]
    },
    {
      "id": "audio",
      "name": "Музыка и звук",
      "description": "Запись, монтаж, ноты, синтезаторы",
      "packages": ["audacity", "ardour", "lmms", "musescore3", "rosegarden", "hydrogen"]
    },
    {
      "id": "video",
      "name": "Видеомонтаж",
      "description": "Монтаж, конвертация, запись экрана и стрим",
      "packages": ["kdenlive", "openshot-qt", "handbrake", "obs-studio", "guvcview"]
    },
    {
      "id": "education",
      "name": "Обучение и наука",
      "description": "Планетарий, карты, математика и графики",
      "packages": ["stellarium", "kgeography", "kstars", "gcompris-qt", "gnuplot", "octave"]
    },
    {
      "id": "virtual",
      "name": "Виртуальные машины",
      "description": "QEMU, GNOME Boxes и virt-manager",
      "packages": ["virt-manager", "gnome-boxes", "qemu-system-x86", "libvirt-daemon-system"]
    },
    {
      "id": "containers",
      "name": "Контейнеры",
      "description": "Docker, Podman, Buildah и Skopeo",
      "packages": ["docker.io", "podman", "buildah", "skopeo"]
    },
    {
      "id": "privacy",
      "name": "Приватность",
      "description": "Менеджер паролей, песочница, проверка системы",
      "packages": ["keepassxc", "firejail", "gufw", "rkhunter", "clamtk"]
    },
    {
      "id": "access",
      "name": "Доступность",
      "description": "Экранный диктор, синтез речи, экранная клавиатура",
      "packages": ["orca", "espeak-ng", "onboard", "dasher"]
    },
    {
      "id": "cad",
      "name": "3D и черчение",
      "description": "FreeCAD, OpenSCAD, KiCad, LibreCAD",
      "packages": ["freecad", "openscad", "kicad", "librecad"]
    },
    {
      "id": "emulators",
      "name": "Эмуляторы",
      "description": "RetroArch, DOSBox, ScummVM, Mednafen",
      "packages": ["retroarch", "dosbox", "scummvm", "mednafen"]
    },
    {
      "id": "office-extra",
      "name": "Офис дополнительно",
      "description": "Базы данных, формулы, PDF, электронные книги",
      "packages": ["libreoffice-base", "libreoffice-math", "okular", "calibre"]
    }
  ]
}
