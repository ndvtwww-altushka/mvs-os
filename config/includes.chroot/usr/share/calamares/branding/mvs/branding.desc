---
# MVS OS — оформление установщика.
componentName: mvs

strings:
    productName: MVS OS
    shortProductName: MVS
    version: "@VERSION@"
    shortVersion: "@VERSION@"
    versionedName: MVS OS @VERSION@ «@CODENAME@»
    shortVersionedName: MVS @VERSION@
    bootloaderEntryName: MVS OS
    productUrl: "https://github.com/"
    supportUrl: "https://github.com/"

# Логотип берётся из фирменного SVG. Если Qt не смог загрузить SVG,
# Calamares просто не покажет картинку и продолжит установку.
images:
    productLogo: "/usr/share/pixmaps/mvs-logo.svg"
    productIcon: "/usr/share/pixmaps/mvs-logo.svg"

style:
    sidebarBackground: "#16161e"
    sidebarText: "#c0caf5"
    sidebarTextSelect: "#7aa2f7"
