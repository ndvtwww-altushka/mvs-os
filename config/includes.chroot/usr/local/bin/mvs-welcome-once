#!/bin/sh
# MVS OS — мастер первого запуска, но только один раз.
#
# Автозапуск вызывает этот файл. Если мастер уже пройден, окно не появляется.
# Ручной запуск из меню идёт напрямую через mvs-welcome и работает всегда.

MARKER="$HOME/.config/mvs/welcome-done"
[ -f "$MARKER" ] && exit 0

# Даём панели и рабочим столу подняться, чтобы окно встало по центру.
sleep 2
exec python3 /usr/lib/mvs/apps/mvs_welcome.py
