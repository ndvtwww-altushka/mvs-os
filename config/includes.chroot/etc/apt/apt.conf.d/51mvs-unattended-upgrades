# MVS OS — обновления безопасности.
#
# Автоматически ставятся только обновления безопасности Debian.
# Обычные обновления программ — вручную через MVS Update: так система
# не меняется неожиданно посреди работы.

Unattended-Upgrade::Allowed-Origins {
    "origin=Debian,codename=${distro_codename},label=Debian-Security";
    "origin=Debian,codename=${distro_codename}-security,label=Debian-Security";
};

# Перезагрузку не делаем сами: решает пользователь.
Unattended-Upgrade::Automatic-Reboot "false";

# Чистить зависимости, которые больше не нужны.
Unattended-Upgrade::Remove-Unused-Dependencies "true";

# Не трогать пакеты, которые пользователь держит намеренно.
Unattended-Upgrade::Package-Blacklist {
};
