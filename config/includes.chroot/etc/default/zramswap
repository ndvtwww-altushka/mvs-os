# MVS OS — сжатый swap в оперативной памяти (zram).
#
# Зачем: на машинах с 2–4 ГБ RAM обычный swap на диске уже поздно подключать
# при нехватке памяти, а zram сжимает страницы и отдаёт их быстрее.
# 25% RAM — компромисс: помогает при пиковой нагрузке и не отнимает
# память у системы постоянно (zram выделяет её по мере использования).

ALGO=zstd
PERCENT=25
PRIORITY=100
