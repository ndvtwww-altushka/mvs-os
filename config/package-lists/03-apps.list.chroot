# MVS OS 1.0 — приложения.
#
# Обязательные программы и библиотеки для фирменных приложений MVS.
# Всё остальное (офис, Steam, GIMP, VS Code) ставится из MVS Store —
# так базовый ISO остаётся разумного размера.

# --- среда приложений MVS (Python 3 + GTK 3) ----------------------------
python3
python3-gi
python3-gi-cairo
python3-cairo
# gio/gdbus нужны Thunar и xdg-open; без них часть запусков молчалива.
libglib2.0-bin
# notify-send: приложение сообщает об ошибке, а не «ничего не произошло».
libnotify-bin
gir1.2-gtk-3.0
gir1.2-glib-2.0
gir1.2-gdkpixbuf-2.0

# --- повседневное -------------------------------------------------------
firefox-esr

# --- игры из коробки ----------------------------------------------------
aisleriot
gnome-mines

# --- мониторинг ---------------------------------------------------------
xfce4-taskmanager
